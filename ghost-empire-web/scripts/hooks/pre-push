#!/usr/bin/env bash
# Local pre-push gate — MANUAL FALLBACK ONLY.
#
# AUDIT [4]: the repo shipped TWO competing pre-push mechanisms — this file
# (manual `cp` into .git/hooks, web-only) and lefthook (root package.json
# `prepare: lefthook install`, which OVERWRITES this hook when it runs).
# Whichever installed last won, and the manual copy silently dropped the chat
# typecheck and the commit-msg gate. Resolution: **lefthook.yml is the single
# canonical hook mechanism** (installed automatically by `npm install` in the
# repo root). This file stays only as an equivalent fallback for clones that
# never ran root `npm install`, and it now runs THE SAME gates as lefthook's
# pre-push, so the "whichever ran last" race can no longer change behaviour:
#   web:  verify-all --fast → typecheck · lint · docs:check · docs:env ·
#         docs:i18n · docs:i18n:dup · docs:rls · unit  (no integration/DB)
#   chat: tsc --noEmit (the only gate chat has)
# Run the FULL suite incl. integration before merging to main: npm run verify-all
# Bypass in a pinch:  git push --no-verify
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root/ghost-empire-web" 2>/dev/null || exit 0   # nothing to check outside the app
echo "▶ pre-push gate: verify-all --fast + chat typecheck  (canonical hook: lefthook.yml · full: npm run verify-all · bypass: --no-verify)"
npm run --silent verify-all:fast
# Mirror lefthook's `chat-typecheck` so the fallback is not weaker than the
# canonical hook (audit [4]) — skip gracefully if the sibling isn't checked out.
if [[ -d "$root/ghost-empire-chat" ]]; then
  echo "▶ pre-push gate: ghost-empire-chat typecheck"
  (cd "$root/ghost-empire-chat" && npm run --silent typecheck)
fi
