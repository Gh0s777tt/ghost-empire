# Example per-tenant bot instance (SaaS multi-tenant — one PROCESS per portal).
# Copy to tenants/<slug>.env, fill in, then run:
#   ENV_FILE=tenants/<slug>.env npm start
# Each instance is fully isolated: its own portal URL (the tenant's subdomain),
# its own channels and its own bot credentials.

# The tenant's portal — the subdomain resolves the tenant server-side (Host),
# so every award/command/FAQ/timer call lands in THIS tenant's data.
PORTAL_URL=https://example-tenant.your-product-domain.com

# Auth for the portal's bot endpoints. TWO values are accepted:
#   1. this portal's OWN secret — the `Tenant.botSecret` set for this tenant (PREFERRED),
#   2. the platform-wide BOT_SECRET of the portal deployment (works, but it is the
#      first-party/founder key — don't hand it to a third-party streamer).
# Prefer (1): the portal scopes every user/GT lookup to the tenant that owns the secret,
# so this instance can only ever touch ITS OWN viewers.
# NOTE: `Tenant.botSecret` is set directly on the tenants row today (no admin UI yet) —
# until it exists for this portal, use the platform-wide BOT_SECRET (still accepted).
BOT_SECRET=this-tenants-own-Tenant.botSecret

# NIE MA TU nazwy waluty — i tak ma być.
# Waluta pokazywana widzom na czacie (tokenName/tokenSymbol) jest pobierana z portalu
# (GET <PORTAL_URL>/api/companion/branding) przy starcie i odświeżana co 30 min.
# Jedynym źródłem prawdy jest wiersz `Tenant` portalu, edytowalny w /admin — zmiana
# nazwy waluty wchodzi na czat sama, bez restartu bota i bez edycji tego pliku.
# Gdy portal jest nieosiągalny, bot używa neutralnego „tokeny"/„pkt" (nigdy waluty
# portalu-założyciela). Szczegóły: README → „White-label: bot mówi walutą SWOJEGO portalu".

# Twitch (required)
TWITCH_BOT_USERNAME=YourBotAccount
TWITCH_CHANNEL=tenants_twitch_channel
# oauth via `npm run auth:twitch` (or client-id/secret + refresh below)
# TWITCH_BOT_OAUTH=oauth:xxxxxxxxxxxx
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_BOT_REFRESH=

# Kick (optional — leave unset to disable)
# KICK_CHANNEL=tenants_kick_slug
# KICK_BROADCASTER_ID=
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# KICK_BOT_TOKEN=
# KICK_BOT_REFRESH=

# YouTube (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YOUTUBE_BOT_REFRESH_TOKEN=
