# Ghost Empire Chat Bot — copy to `.env` and fill in.
# `.env` is gitignored (root **/.env) — NEVER put real secrets here in .env.example.

# Portal economy API
PORTAL_URL=https://ghost-empire-web.vercel.app
BOT_SECRET=                  # the portal's BOT_SECRET (same value the Discord bot uses).
                             # This is the founder/first-party key. A per-portal bot instance
                             # should instead use that tenant's own Tenant.botSecret — see
                             # tenants/example-tenant.env + README "Multi-tenant".

# --- Twitch (bot account) ---
TWITCH_BOT_USERNAME=
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_OAUTH=            # filled by the one-time `npm run auth:twitch`
TWITCH_BOT_REFRESH=         # filled by `npm run auth:twitch`; enables auto-refresh (no ~4h drop)

# --- Kick (bot account) ---
KICK_CHANNEL=               # streamer's channel slug (chat to read); used to look up the chatroom id
KICK_CHATROOM_ID=           # streamer's legacy chatroom id (Pusher subscription); from kick.com/api/v2/channels/<slug> → chatroom.id
KICK_BROADCASTER_ID=        # streamer's user id (channels JSON → user_id); required to send replies (type:"user")
KICK_PUSHER_KEY=            # optional: override Kick's public Pusher app key if it rotates
KICK_CLIENT_ID=             # from dev.kick.com app
KICK_CLIENT_SECRET=         # from dev.kick.com app
KICK_BOT_TOKEN=             # filled by the one-time `npm run auth:kick`
KICK_BOT_REFRESH=           # filled by the one-time `npm run auth:kick` (auto-rotated into .kick-tokens.json)
KICK_TOKEN_STORE=           # optional: path for the rotated refresh token (default .kick-tokens.json; set to a mounted volume on ephemeral hosts)

# --- YouTube (Option C: authorize the CHANNEL account; uses the main Google app) ---
# Setup: enable "YouTube Data API v3" in the Google Cloud project, add http://localhost:3000
# as a Redirect URI, and (if the consent screen is in Testing) add the channel as a Test user.
# Both YOUTUBE_* below are informational only — nothing in src/ or scripts/ reads them.
# Discovery uses liveBroadcasts.list with broadcastStatus=active (already scoped to the
# authorized channel). Do NOT add mine=true: the two filters are mutually exclusive and
# together return 400 incompatibleParameters — see the comment at src/youtube.ts discover().
YOUTUBE_CHANNEL=            # informational only (not read by the bot)
YOUTUBE_BOT_HANDLE=         # informational only (not read by the bot)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_BOT_REFRESH_TOKEN=  # filled by the one-time `npm run auth:youtube` (authorize the channel account)
YT_AUTH_REDIRECT=           # optional: OAuth redirect port/URL for `npm run auth:youtube`
                            # (default http://localhost:3000 — scripts/auth-youtube.ts). Whatever
                            # you set here must be registered VERBATIM as an Authorized redirect
                            # URI on the Google OAuth client, or auth fails redirect_uri_mismatch.
